<mix = 'http://www.jcp.org/jcr/mix/1.0'>
<jnt = 'http://www.jahia.org/jahia/nt/1.0'>
<jmix = 'http://www.jahia.org/jahia/mix/1.0'>
<eximgynt = 'http://modules.se.jahia.org/exactly/nt/1.0'>
<eximgmix = 'http://modules.se.jahia.org/exactly/mix/1.0'>
<eximg = 'http://modules.se.jahia.org/exactly/eximg/1.0'>

//------------------------------------------------------------------------------
// Exactly.ai Style Node Type
// Stores reference to an Exactly style/model with metadata
//------------------------------------------------------------------------------
[eximgynt:style] > jnt:content, jmix:editorialContent, mix:title
 - eximg:exactlyId (string) indexed=no
 - eximg:name (string)
 - eximg:status (string) = 'unknown' autocreated indexed=no < 'unknown', 'draft', 'active', 'training', 'ready', 'failed'
 - eximg:active (boolean) = 'false' autocreated indexed=no
 - eximg:lastSynced (date)
 - eximg:metadata (string, textarea) indexed=no
 - eximg:params (string, textarea) indexed=no

//------------------------------------------------------------------------------
// Mixin to allow Exactly.ai content as children
//------------------------------------------------------------------------------
[eximgmix:exactlyContainer] > jmix:droppableContent mixin
 + * (eximgynt:style)
 + * (eximgynt:project)

//------------------------------------------------------------------------------
// Exactly.ai Project Node Type  
// Stores training job or generation job with prompt, status, and results
//------------------------------------------------------------------------------
[eximgynt:project] > jnt:content, jmix:editorialContent
 - eximg:type (string) = 'generation' autocreated < 'training', 'generation'
 - eximg:styleUuid (string) indexed=no
 - eximg:prompt (string, textarea) indexed=no
 - eximg:status (string) = 'pending' autocreated < 'pending', 'processing', 'completed', 'failed'
 - eximg:paramsJson (string, textarea) indexed=no
 - eximg:metadata (string, textarea) indexed=no
 - eximg:remoteJobId (string) indexed=no
 - eximg:generatedRemoteUrls (string, textarea) multiple indexed=no
 - eximg:generatedAssetUuids (string) multiple indexed=no
 - eximg:createdAt (date) = now() autocreated
 - eximg:updatedAt (date) = now() autocreated

